{
  "Classes": {
    "Typed Buffers": [
      "Buffer",
      "RWBuffer"
    ],
    "Raw Buffers": [
      "ByteAddressBuffer",
      "RWByteAddressBuffer"
    ],
    "Structured Buffers": [
      ".*StructuredBuffer.*"
    ],
    "Textures": [
      "(RW)?Texture.*"
    ],
    "DirectX Shader Model 6.8": [
      ".*Node.*"
    ],
    "Ray Tracing": [
      "RayQuery"
    ],
    "DirectX Shader Model 6.9": [
      "dx::HitObject"
    ],
    "Vulkan": [
      "vk::.*"
    ]
  },
  "Functions": {
    "Resources" : ["CheckAccessFullyMapped", "NonUniformResourceIndex"],
    "Conversion Functions" : [
      "asdouble", "asfloat(16)?", "as(u)?int(16|64)?", "f16tof32", "f32tof16"
    ],
    "Atomic Operations": [
      "^Interlocked.*"
    ],
    "Threading Support": [
      ".*Barrier.*"
    ],
    "SPMD Support": [
      ".*Wave.*", "QuadRead.*", "QuadAny", "QuadAll"
    ],
    "Ray Tracing": [
      "TraceRay", "RayQuery", "CallShader", "ReportHit", "IgnoreHit",
      "AcceptHitAndEndSearch", "DispatchRaysIndex", "DispatchRaysDimensions",
      "WorldRayOrigin", "WorldRayDirection", "ObjectRayOrigin", "ObjectRayDirection",
      "RayTMin", "RayTCurrent", "PrimitiveIndex", "InstanceID", "InstanceIndex",
      "GeometryIndex", "HitKind", "RayFlags", "ObjectToWorld.*", "WorldToObject.*",
      "TriangleObjectPositions", "ClusterID"
    ],
    "DirectX Shader Model 6.8": [
      "GetRemainingRecursionLevels"
    ],
    "DirectX Shader Model 6.9": [
      "dx::MaybeReorder.*"
    ],
    "DirectX Shader Model 6.10": [
      "dx::IsDebuggingEnabled"
    ],
    "DirectX Shader Model 6.10 - impl": [
      "__builtin_LinAlg.*"
    ],
    "Vulkan": [
      "vk::.*"
    ],
    "Barycentrics": [
      "EvaluateAttribute.*",
      "GetAttributeAtVertex"
    ],
    "Unsupported": [
      "abort", "printf", "source_mark"
    ],
    "Tesselation Shaders": [
      "Process.*TessFactors.*"
    ],
    "Mesh Shaders" : [
      "DispatchMesh",
      "SetMeshOutputCounts"
    ],
    "Pixel Shaders" : [
      "GetRenderTargetSampleCount",
      "GetRenderTargetSamplePosition"
    ],
    "DirectX Legacy": ["D3DCOLOR.*", "tex(1|2||3)D.*", "texCUBE.*"]
  }
}